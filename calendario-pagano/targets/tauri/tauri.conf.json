{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Calendario Pagano",
  "version": "0.9.1",
  "identifier": "com.lacaetra.calendariopagano",
  "build": {
    "frontendDist": "../../dist/web"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "Calendario Pagano",
        "width": 360,
        "height": 360,
        "resizable": false,
        "maximizable": false,
        "minimizable": false,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnBottom": true,
        "skipTaskbar": true,
        "visibleOnAllWorkspaces": true,
        "focus": false,
        "center": false,
        "x": 60,
        "y": 60
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "rpm", "appimage", "nsis", "dmg", "app"],
    "category": "Utility",
    "shortDescription": "Rueda del año celta en el escritorio",
    "longDescription": "Widget de escritorio con la rueda del año: las ocho fiestas, el día del calendario celta de Coligny y la fase lunar. Autoría de contenidos: Andrea M. Miranda Duque y Fernando A. Muñoz Villarejo - La Caetra, retrocultura (https://lacaetra.com/).",
    "copyright": "© La Caetra, retrocultura · GPL-3.0-or-later",
    "publisher": "La Caetra, retrocultura",
    "homepage": "https://lacaetra.com/",
    "license": "GPL-3.0-or-later",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Spanish", "English"],
        "displayLanguageSelector": false,
        "installMode": "currentUser"
      }
    },
    "linux": {
      "deb": { "section": "utils" }
    }
  }
}
